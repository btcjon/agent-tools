# Configure these in the codex-router SERVICE environment, not only a shell.
# This example contains no credentials. Replace the SSH alias with your own.
HERMES_PICKER_SSH_HOST=hermes-host
HERMES_PICKER_REMOTE_BASE_URL=http://127.0.0.1:8766
HERMES_PICKER_REMOTE_ENV_PATH=~/.hermes/.env
HERMES_PICKER_ALLOWED_ARTIFACT_ROOTS=/tmp/codex-hermes-artifacts
HERMES_PICKER_ALLOW_CREATE=true
HERMES_PICKER_TIMEOUT_MS=240000
# Default off. Enable only with a reviewed host-local advisor profile.
HERMES_PICKER_SKILL_INJECTION=false
HERMES_PICKER_SKILL_PROFILE=/absolute/path/to/jev-profile.json
HERMES_PICKER_SKILL_EXECUTABLE=skill-advisor-service
HERMES_PICKER_SKILL_TIMEOUT_MS=7000
HERMES_PICKER_SKILL_BODY_MAX_BYTES=32768
# Absolute file URL for this package's src/hermes-picker-adapter.mjs:
HERMES_PICKER_ADAPTER_MODULE=file:///absolute/path/to/hermes-router/src/hermes-picker-adapter.mjs
